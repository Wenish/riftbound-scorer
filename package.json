{
  "name": "riftbound-scorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --passWithNoTests",
    "tauri": "tauri",
    "generate-pwa-assets": "node -e \"fs.copyFileSync('src-tauri/app-icon.png','public/pwa-source.png')\" && pwa-assets-generator && node -e \"fs.rmSync('public/pwa-source.png')\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "idb": "^8.0.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
